NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reduce_video

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File storage paths (relative to project root)
UPLOADS_DIR=uploads
OUTPUT_DIR=output

# Max upload size in MB
MAX_UPLOAD_MB=500

# Max simultaneous FFmpeg processes
FFMPEG_CONCURRENCY=2

# Hours before a job/file is eligible for cleanup
JOB_TTL_HOURS=24

# CORS allowed origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000

# Swagger basic auth
SWAGGER_USER=admin
SWAGGER_PASSWORD=dev-only

# Rate limiting (requests per THROTTLE_TTL seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=30
